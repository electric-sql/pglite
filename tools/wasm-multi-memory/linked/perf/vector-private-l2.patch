 }
 
+/* SQL vector arguments are immutable for the duration of a distance call. */
+__attribute__((noinline)) static float
+VectorL2Staged(int dim, float *a, float *b)
+{
+    enum { chunk = 256 };
+    float left[chunk], right[chunk];
+    float distance = 0;
+    while (dim > 0)
+    {
+        int n = Min(dim, chunk);
+        float *ax = a, *bx = b;
+        if ((uintptr_t) a >= 0x80000000u)
+        {
+            memcpy(left, a, n * sizeof(float));
+            ax = left;
+        }
+        if ((uintptr_t) b >= 0x80000000u)
+        {
+            memcpy(right, b, n * sizeof(float));
+            bx = right;
+        }
+        distance = VectorL2Private(n, ax, bx, distance);
+        a += n;
+        b += n;
+        dim -= n;
+    }
+    return distance;
+}
+
+VECTOR_TARGET_CLONES static float
+VectorL2SquaredDistance(int dim, float *a, float *b)
+{
+    if (dim <= 0) return 0;
+    if (!FitsFloatSpan(a, dim) || !FitsFloatSpan(b, dim))
+        return VectorL2Generic(dim, a, b);
+    if (((uintptr_t) a | (uintptr_t) b) < 0x80000000u)
+        return VectorL2Private(dim, a, b, 0);
+    return VectorL2Staged(dim, a, b);
+}
