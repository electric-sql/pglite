+VECTOR_TARGET_CLONES static inline float
+VectorL2Private(int dim, float *a, float *b, float distance)
+{
+    for (int i = 0; i < dim; i++)
+    {
+        float diff = pgl_private_read_f32(a + i) - pgl_private_read_f32(b + i);
+        distance += diff * diff;
