+/* Read a float in this instance's ordinary Wasm memory. */
+extern float pgl_private_read_f32(const float *) __attribute__((pure));
+
+static inline int
+FitsFloatSpan(float *p, unsigned count)
+{
+    uintptr_t addr = (uintptr_t) p;
+    unsigned remaining = addr < 0x80000000u ? 0x80000000u - addr :
+        0x40000000u - (addr & 0x3fffffffu);
+    return addr != 0 && count <= remaining / sizeof(float);
 }
 
